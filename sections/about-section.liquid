{% schema %}
{
  "name": "About Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We started with one question: Why choose between comfort and statement?"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Sub Text",
      "default": "Founded by creators who live at the intersection of edgy design and cultural roots, Cross Seams is for those who wear confidence like a second skin.\n\nWhether it’s your Monday mood or wedding season glam—our drops are crafted to reflect real personalities, real moments, and real drama."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Side Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "text-left", "label": "Text Left - Image Right" },
        { "value": "text-right", "label": "Text Right - Image Left" }
      ],
      "default": "text-left"
    }
  ],
  "presets": [
    {
      "name": "About Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<section class="about-section {{ section.settings.layout }}">
  <div class="about-content">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext | newline_to_br }}</p>
  </div>
  <div class="about-image">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 800 }}" alt="About Image">
    {% endif %}
  </div>
</section>

<style>
.about-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  padding: 60px 20px;
  border-radius: 12px;
  background: #f9f9f9;
}

.about-section.text-left {
  flex-direction: row;
}

.about-section.text-right {
  flex-direction: row-reverse;
}

.about-content {
  flex: 1;
}

.about-content h2 {
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 20px;
  line-height: 1.3;
}

.about-content p {
  font-size: 16px;
  line-height: 1.6;
  color: #444;
}

.about-image {
  flex: 1;
}

.about-image img {
  width: 100%;
  border-radius: 12px;
  object-fit: cover;
}
</style>
